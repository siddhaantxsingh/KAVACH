<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- OEM/system mode only (docs/oem_mode.md): granted ONLY when a phone maker ships KAVACH Guardian
         as a privileged system app. Ordinary installs never receive it and use the microphone. -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- same-phone link between KAVACH Guardian and KAVACH Shield: only apps signed with
         the same key can hold this permission, so no other app can read or fake messages -->
    <permission android:name="io.kavach.permission.LINK" android:protectionLevel="signature" />
    <uses-permission android:name="io.kavach.permission.LINK" />
    <queries>
        <package android:name="io.kavach.shield" />
    </queries>
    <!-- deliberately NO INTERNET permission: nothing can leave this phone -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:label="KAVACH Guardian"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:extractNativeLibs="true">

        <activity
            android:name=".GuardianActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GuardianService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
